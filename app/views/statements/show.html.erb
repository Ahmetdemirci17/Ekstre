<div class="space-y-6">
  <!-- Top Navigation & Title -->
  <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs text-slate-400 mb-1">
        <%= link_to "← Ekstreler", statements_path, class: "hover:text-white transition-colors" %>
        <span>/</span>
        <span class="text-slate-200"><%= @statement.source_filename %></span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white flex items-center gap-3">
        <span><%= @statement.bank_name.presence || "Banka Ekstresi" %></span>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold <%= @statement.status == 'categorized' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/30' : 'bg-amber-500/10 text-amber-400 border border-amber-500/30' %>">
          <%= @statement.status.humanize %>
        </span>
      </h1>
      <p class="text-xs text-slate-400 mt-1">Yükleme: <%= @statement.imported_at.strftime("%d.%m.%Y %H:%M") %></p>
    </div>

    <div class="flex items-center gap-3">
      <%= button_to categorize_statement_path(@statement), method: :post, class: "inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-bold text-sm shadow-lg shadow-purple-600/20 transition-all hover:scale-[1.02] active:scale-[0.98] cursor-pointer" do %>
        <span>✨</span>
        <span>Yapay Zeka ile Kategorize Et</span>
      <% end %>

      <%= button_to statement_path(@statement), method: :delete, data: { turbo_confirm: "Bu ekstreyi silmek istediğinize emin misiniz?" }, class: "p-2.5 rounded-xl bg-slate-900 border border-slate-800 hover:bg-rose-500/10 hover:border-rose-500/30 text-rose-400 text-sm transition-colors cursor-pointer", title: "Ekstreyi Sil" do %>
        🗑️
      <% end %>
    </div>
  </div>

  <!-- Summary KPI Cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
    <div class="bg-slate-900/70 border border-slate-800/80 rounded-2xl p-4 backdrop-blur-sm">
      <span class="text-xs font-medium text-slate-400">Toplam Harcama</span>
      <p class="text-xl sm:text-2xl font-bold text-rose-400 mt-1"><%= sprintf("%.2f TL", @statement.total_spent) %></p>
    </div>

    <div class="bg-slate-900/70 border border-slate-800/80 rounded-2xl p-4 backdrop-blur-sm">
      <span class="text-xs font-medium text-slate-400">Toplam Gelir</span>
      <p class="text-xl sm:text-2xl font-bold text-emerald-400 mt-1"><%= sprintf("%.2f TL", @statement.total_income) %></p>
    </div>

    <div class="bg-slate-900/70 border border-slate-800/80 rounded-2xl p-4 backdrop-blur-sm">
      <span class="text-xs font-medium text-slate-400">İşlem Sayısı</span>
      <p class="text-xl sm:text-2xl font-bold text-white mt-1"><%= @statement.transactions.count %></p>
    </div>

    <div class="bg-slate-900/70 border border-slate-800/80 rounded-2xl p-4 backdrop-blur-sm">
      <span class="text-xs font-medium text-slate-400">Kategorilenme Oranı</span>
      <div class="flex items-center gap-2 mt-1">
        <p class="text-xl sm:text-2xl font-bold text-purple-400">%<%= @statement.categorization_percentage %></p>
        <span class="text-xs text-slate-500">(<%= @statement.categorized_count %> / <%= @statement.transactions.count %>)</span>
      </div>
    </div>
  </div>

  <!-- Transactions Table -->
  <div class="bg-slate-900/70 border border-slate-800/80 rounded-2xl overflow-hidden backdrop-blur-sm shadow-xl">
    <div class="p-4 sm:p-5 border-b border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <h2 class="text-lg font-semibold text-white">İşlem Hareketleri</h2>
      <p class="text-xs text-slate-400">Kategoriyi değiştirmek için aşağıdaki açılır kutuyu kullanabilirsiniz (otomatik kaydedilir).</p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-slate-300">
        <thead class="bg-slate-950/60 text-xs uppercase tracking-wider text-slate-400 border-b border-slate-800/80">
          <tr>
            <th class="py-3 px-4 font-semibold">Tarih</th>
            <th class="py-3 px-4 font-semibold">Açıklama</th>
            <th class="py-3 px-4 font-semibold text-right">Tutar</th>
            <th class="py-3 px-4 font-semibold">Kategori</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60 font-normal">
          <% @transactions.each do |transaction| %>
            <tr class="hover:bg-slate-800/40 transition-colors">
              <td class="py-3.5 px-4 whitespace-nowrap text-xs font-mono text-slate-400">
                <%= transaction.date.strftime("%d.%m.%Y") %>
              </td>
              <td class="py-3.5 px-4 max-w-md">
                <div class="font-medium text-white text-xs sm:text-sm truncate" title="<%= transaction.description %>">
                  <%= transaction.description %>
                </div>
                <% if transaction.raw_row.present? %>
                  <div class="text-[11px] font-mono text-slate-500 truncate" title="<%= transaction.raw_row %>">
                    <%= transaction.raw_row %>
                  </div>
                <% end %>
              </td>
              <td class="py-3.5 px-4 whitespace-nowrap text-right font-semibold text-sm">
                <% if transaction.amount.negative? %>
                  <span class="text-rose-400"><%= sprintf("%.2f TL", transaction.amount) %></span>
                <% else %>
                  <span class="text-emerald-400">+<%= sprintf("%.2f TL", transaction.amount) %></span>
                <% end %>
              </td>
              <td class="py-3.5 px-4 whitespace-nowrap">
                <%= render "transactions/category_cell", transaction: transaction %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
