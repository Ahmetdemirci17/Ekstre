<div class="space-y-6">
  <!-- Top Navigation & Title -->
  <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4 pb-2 border-b border-zinc-900">
    <div>
      <div class="flex items-center gap-2 text-xs text-zinc-400 mb-1">
        <%= link_to "← Ekstre Listesi", statements_path, class: "hover:text-white transition-colors" %>
        <span>/</span>
        <span class="text-zinc-200 font-semibold"><%= @statement.source_filename %></span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white flex items-center gap-3">
        <span><%= @statement.bank_name.presence || "Banka Hesap Ekstresi" %></span>
        <span class="px-2.5 py-0.5 rounded-md text-[11px] font-bold uppercase <%= @statement.status == 'categorized' ? 'bg-red-600/10 text-red-500 border border-red-600/25' : 'bg-zinc-800 text-zinc-300 border border-zinc-700' %>">
          <%= @statement.status.humanize %>
        </span>
      </h1>
      <p class="text-xs text-zinc-400 mt-1 font-tabular">Yükleme Zamanı: <%= @statement.imported_at.strftime("%d.%m.%Y • %H:%M") %></p>
    </div>

    <div class="flex items-center gap-3">
      <%= button_to categorize_statement_path(@statement), method: :post, class: "inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-red-600 hover:bg-red-500 text-white font-bold text-xs sm:text-sm shadow-md shadow-red-600/20 transition-all active:scale-[0.98] cursor-pointer" do %>
        <span>⚡</span>
        <span>Yapay Zeka ile Analiz Et</span>
      <% end %>

      <%= button_to statement_path(@statement), method: :delete, data: { turbo_confirm: "Bu ekstreyi ve tüm hareketlerini silmek istediğinize emin misiniz?" }, class: "p-2.5 rounded-xl bg-zinc-900 border border-zinc-800 hover:bg-red-950/50 hover:border-red-800/40 text-red-400 text-sm transition-colors cursor-pointer", title: "Ekstreyi Sil" do %>
        🗑️
      <% end %>
    </div>
  </div>

  <!-- Summary KPI Cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
    <div class="bg-[#121215] border-t-2 border-t-red-600 border border-zinc-800 rounded-2xl p-4 shadow-lg">
      <span class="text-xs font-semibold text-zinc-400">Toplam Gider</span>
      <p class="text-xl sm:text-2xl font-black text-red-400 mt-1 font-tabular"><%= sprintf("%.2f ₺", @statement.total_spent) %></p>
    </div>

    <div class="bg-[#121215] border border-zinc-800 rounded-2xl p-4 shadow-lg">
      <span class="text-xs font-semibold text-zinc-400">Toplam Gelir</span>
      <p class="text-xl sm:text-2xl font-black text-emerald-400 mt-1 font-tabular"><%= sprintf("%.2f ₺", @statement.total_income) %></p>
    </div>

    <div class="bg-[#121215] border border-zinc-800 rounded-2xl p-4 shadow-lg">
      <span class="text-xs font-semibold text-zinc-400">İşlem Adedi</span>
      <p class="text-xl sm:text-2xl font-black text-white mt-1 font-tabular"><%= @statement.transactions.count %></p>
    </div>

    <div class="bg-[#121215] border border-zinc-800 rounded-2xl p-4 shadow-lg">
      <span class="text-xs font-semibold text-zinc-400">Kategorilenme</span>
      <div class="flex items-center gap-2 mt-1">
        <p class="text-xl sm:text-2xl font-black text-white font-tabular">%<%= @statement.categorization_percentage %></p>
        <span class="text-[11px] font-medium text-zinc-500 font-tabular">(<%= @statement.categorized_count %> / <%= @statement.transactions.count %>)</span>
      </div>
    </div>
  </div>

  <!-- Transactions Table -->
  <div class="bg-[#121215] border border-zinc-800 rounded-2xl overflow-hidden shadow-2xl">
    <div class="p-4 sm:p-5 border-b border-zinc-900 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <div>
        <h2 class="text-base font-bold text-white tracking-tight">Hesap Hareketleri</h2>
        <p class="text-xs text-zinc-400">Kategori seçimini değiştirdiğinizde anında kaydedilir.</p>
      </div>
      <div class="text-xs text-zinc-400">
        Gösterilen: <span class="font-bold text-white"><%= @transactions.count %></span> işlem
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-zinc-300">
        <thead class="bg-[#0D0D10] text-[11px] uppercase tracking-wider text-zinc-400 border-b border-zinc-800/80">
          <tr>
            <th class="py-3.5 px-4 font-bold">Tarih</th>
            <th class="py-3.5 px-4 font-bold">İşlem Detayı</th>
            <th class="py-3.5 px-4 font-bold text-right">Tutar</th>
            <th class="py-3.5 px-4 font-bold">Kategori</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-900 font-normal">
          <% @transactions.each do |transaction| %>
            <tr class="hover:bg-zinc-900/50 transition-colors">
              <td class="py-3.5 px-4 whitespace-nowrap text-xs font-tabular text-zinc-400">
                <%= transaction.date.strftime("%d.%m.%Y") %>
              </td>
              <td class="py-3.5 px-4 max-w-md">
                <div class="font-semibold text-white text-xs sm:text-sm truncate" title="<%= transaction.description %>">
                  <%= transaction.description %>
                </div>
                <% if transaction.raw_row.present? %>
                  <div class="text-[11px] font-mono text-zinc-500 truncate mt-0.5" title="<%= transaction.raw_row %>">
                    <%= transaction.raw_row %>
                  </div>
                <% end %>
              </td>
              <td class="py-3.5 px-4 whitespace-nowrap text-right font-bold text-xs sm:text-sm font-tabular">
                <% if transaction.amount.negative? %>
                  <span class="text-red-400"><%= sprintf("%.2f ₺", transaction.amount) %></span>
                <% else %>
                  <span class="text-emerald-400">+<%= sprintf("%.2f ₺", transaction.amount) %></span>
                <% end %>
              </td>
              <td class="py-3.5 px-4 whitespace-nowrap">
                <%= render "transactions/category_cell", transaction: transaction %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
