<div class="space-y-6">
  <!-- Top Navigation & Title -->
  <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4 pb-2 border-b border-[#262830]">
    <div>
      <div class="flex items-center gap-2 text-xs text-zinc-400 mb-1">
        <%= link_to "← Ekstre Listesi", statements_path, class: "hover:text-white transition-colors" %>
        <span>/</span>
        <span class="text-zinc-300 font-medium"><%= @statement.source_filename %></span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white flex items-center gap-3">
        <span><%= @statement.bank_name.presence || "Banka Hesap Ekstresi" %></span>
        <span class="px-2.5 py-0.5 rounded-md text-[11px] font-semibold uppercase <%= @statement.status == 'categorized' ? 'bg-[#241416] text-[#E05252] border border-[#3E1D22]' : 'bg-[#1F2128] text-zinc-300 border border-[#2E303A]' %>">
          <%= @statement.status.humanize %>
        </span>
      </h1>
      <p class="text-xs text-zinc-500 mt-1 font-tabular">Yükleme Zamanı: <%= @statement.imported_at.strftime("%d.%m.%Y • %H:%M") %></p>
    </div>

    <div class="flex items-center gap-3">
      <%= button_to categorize_statement_path(@statement), method: :post, class: "inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-[#B91C1C] hover:bg-[#991B1B] text-zinc-100 font-medium text-xs sm:text-sm transition-colors border border-red-700/60 active:scale-[0.99] cursor-pointer" do %>
        <span>⚡</span>
        <span>Yapay Zeka ile Analiz Et</span>
      <% end %>

      <%= button_to statement_path(@statement), method: :delete, data: { turbo_confirm: "Bu ekstreyi ve tüm hareketlerini silmek istediğinize emin misiniz?" }, class: "p-2 rounded-lg bg-[#18191E] border border-[#262830] hover:bg-[#241416] hover:border-[#3E1D22] text-[#E05252] text-sm transition-colors cursor-pointer", title: "Ekstreyi Sil" do %>
        🗑️
      <% end %>
    </div>
  </div>

  <!-- Summary KPI Cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
    <div class="bg-[#18191E] border-t-2 border-t-[#B91C1C] border border-[#262830] rounded-xl p-4">
      <span class="text-xs font-medium text-zinc-400">Toplam Gider</span>
      <p class="text-xl sm:text-2xl font-bold text-[#E05252] mt-1 font-tabular"><%= sprintf("%.2f ₺", @statement.total_spent) %></p>
    </div>

    <div class="bg-[#18191E] border-t-2 border-t-[#059669] border border-[#262830] rounded-xl p-4">
      <span class="text-xs font-medium text-zinc-400">Toplam Gelir</span>
      <p class="text-xl sm:text-2xl font-bold text-[#34D399] mt-1 font-tabular"><%= sprintf("%.2f ₺", @statement.total_income) %></p>
    </div>

    <div class="bg-[#18191E] border border-[#262830] rounded-xl p-4">
      <span class="text-xs font-medium text-zinc-400">İşlem Adedi</span>
      <p class="text-xl sm:text-2xl font-bold text-white mt-1 font-tabular"><%= @statement.transactions.count %></p>
    </div>

    <div class="bg-[#18191E] border border-[#262830] rounded-xl p-4">
      <span class="text-xs font-medium text-zinc-400">Kategorilenme</span>
      <div class="flex items-center gap-2 mt-1">
        <p class="text-xl sm:text-2xl font-bold text-white font-tabular">%<%= @statement.categorization_percentage %></p>
        <span class="text-[11px] font-medium text-zinc-500 font-tabular">(<%= @statement.categorized_count %> / <%= @statement.transactions.count %>)</span>
      </div>
    </div>
  </div>

  <!-- Transactions Table -->
  <div class="bg-[#18191E] border border-[#262830] rounded-xl overflow-hidden">
    <div class="p-4 sm:p-5 border-b border-[#262830] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <div>
        <h2 class="text-base font-semibold text-white tracking-tight">Hesap Hareketleri</h2>
        <p class="text-xs text-zinc-400">Kategori seçimini değiştirdiğinizde anında kaydedilir.</p>
      </div>
      <div class="text-xs text-zinc-400">
        Gösterilen: <span class="font-semibold text-zinc-200"><%= @transactions.count %></span> işlem
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-zinc-300">
        <thead class="bg-[#141519] text-[11px] uppercase tracking-wider text-zinc-400 border-b border-[#262830]">
          <tr>
            <th class="py-3 px-4 font-semibold">Tarih</th>
            <th class="py-3 px-4 font-semibold">İşlem Detayı</th>
            <th class="py-3 px-4 font-semibold text-right">Tutar</th>
            <th class="py-3 px-4 font-semibold">Kategori</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#22242C] font-normal">
          <% @transactions.each do |transaction| %>
            <tr class="hover:bg-[#1F2128]/60 transition-colors">
              <td class="py-3 px-4 whitespace-nowrap text-xs font-tabular text-zinc-400">
                <%= transaction.date.strftime("%d.%m.%Y") %>
              </td>
              <td class="py-3 px-4 max-w-md">
                <div class="flex items-center gap-2">
                  <% if transaction.merchant_name.present? %>
                    <span class="font-semibold text-white text-xs sm:text-sm"><%= transaction.merchant_name %></span>
                    <% if transaction.categorized_by_ai? %>
                      <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded bg-[#241416] text-[#E05252] border border-[#3E1D22] text-[10px] font-medium" title="Yapay zeka tarafından analiz edildi">
                        ⚡ AI Analizli
                      </span>
                    <% end %>
                  <% else %>
                    <span class="font-medium text-white text-xs sm:text-sm truncate" title="<%= transaction.description %>">
                      <%= transaction.description %>
                    </span>
                  <% end %>
                </div>

                <% if transaction.ai_analysis.present? %>
                  <div class="text-[11px] text-zinc-300 flex items-center gap-1.5 mt-1" title="<%= transaction.ai_analysis %>">
                    <span class="text-[#E05252] font-semibold text-[10px] shrink-0">✦ Analiz:</span>
                    <span class="truncate text-zinc-300"><%= transaction.ai_analysis %></span>
                  </div>
                <% end %>

                <div class="text-[10px] font-mono text-zinc-500 truncate mt-0.5" title="<%= transaction.raw_row.presence || transaction.description %>">
                  <%= transaction.description %>
                </div>
              </td>
              <td class="py-3 px-4 whitespace-nowrap text-right font-semibold text-xs sm:text-sm font-tabular">
                <% if transaction.amount.negative? %>
                  <span class="text-[#E05252]"><%= sprintf("%.2f ₺", transaction.amount) %></span>
                <% else %>
                  <span class="text-[#34D399]">+<%= sprintf("%.2f ₺", transaction.amount) %></span>
                <% end %>
              </td>
              <td class="py-3 px-4 whitespace-nowrap">
                <%= render "transactions/category_cell", transaction: transaction %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

