<div class="max-w-2xl mx-auto">
  <div class="mb-8 text-center">
    <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-[#241416] text-[#E05252] border border-[#3E1D22] mb-3">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
      </svg>
    </div>
    <div class="flex items-center justify-center gap-2 mb-1">
      <span class="inline-block w-2 h-2 rounded-full bg-[#B91C1C]"></span>
      <span class="text-xs font-semibold uppercase tracking-wider text-red-400">Güvenli İçe Aktarım</span>
    </div>
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">Banka Ekstresi Yükle</h1>
    <p class="mt-2 text-xs sm:text-sm text-zinc-400 max-w-md mx-auto">
      Hesap hareketlerinizi içeren CSV dosyasını yükleyin. Yapay zeka tüm harcamaları otomatik olarak analiz etsin.
    </p>
  </div>

  <div class="bg-[#18191E] border border-[#262830] rounded-xl p-6 sm:p-8">
    <%= form_with(model: @statement, url: statements_path, multipart: true, class: "space-y-6") do |f| %>
      <div>
        <label class="block text-xs font-semibold text-zinc-300 uppercase tracking-wider mb-2">Banka Kurumu (İsteğe Bağlı)</label>
        <%= f.select :bank_name, 
              ["Garanti BBVA", "İş Bankası", "Yapı Kredi", "Akbank", "Ziraat Bankası", "QNB Finansbank", "Enpara", "VakıfBank", "Diğer"], 
              { include_blank: "Banka Seçimi Yapın..." }, 
              class: "w-full rounded-lg bg-[#141519] border border-[#262830] text-zinc-200 px-4 py-2.5 text-sm focus:outline-none focus:border-[#B91C1C] transition-colors" %>
      </div>

      <div>
        <label class="block text-xs font-semibold text-zinc-300 uppercase tracking-wider mb-2">Ekstre Dosyası (.CSV)</label>
        <div class="relative border-2 border-dashed border-[#2E303A] hover:border-[#B91C1C]/70 rounded-xl p-8 text-center transition-colors bg-[#141519] group cursor-pointer">
          <input type="file" name="statement[file]" id="statement_file" accept=".csv,text/csv" required
                 class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
                 onchange="document.getElementById('file-chosen').textContent = this.files[0] ? this.files[0].name : 'Dosya seçilmedi'">
          <div class="space-y-2.5 pointer-events-none">
            <svg class="mx-auto h-10 w-10 text-zinc-500 group-hover:text-[#E05252] transition-colors" stroke="currentColor" fill="none" viewBox="0 0 48 48">
              <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div class="text-sm font-medium text-zinc-200">
              <span class="text-[#E05252]">Dosya seçmek için tıklayın</span> veya sürükleyin
            </div>
            <p id="file-chosen" class="text-xs font-mono text-[#E05252] font-medium">Dosya seçilmedi</p>
            <p class="text-[11px] text-zinc-500">Tarih, Açıklama ve Tutar sütunları içeren CSV formatı</p>
          </div>
        </div>
      </div>

      <div class="bg-[#141519] rounded-xl p-4 border border-[#262830] text-xs text-zinc-400 space-y-1.5">
        <div class="font-semibold text-zinc-300 flex items-center gap-1.5">
          <span class="text-[#E05252]">ℹ</span> Desteklenen Banka CSV Biçimleri:
        </div>
        <p>• Tarih formatları: <code class="text-zinc-200 font-mono">15.08.2026</code>, <code class="text-zinc-200 font-mono">15/08/2026</code>, <code class="text-zinc-200 font-mono">2026-08-15</code></p>
        <p>• Tutar formatları: <code class="text-[#E05252] font-mono">-150,50</code>, <code class="text-zinc-200 font-mono">1.250,50 ₺</code> veya ayrı Borç / Alacak sütunları</p>
        <p>• Noktalı virgül (<code class="text-zinc-200">;</code>) ve standart virgül (<code class="text-zinc-200">,</code>) ayraçları otomatik tanınır.</p>
      </div>

      <div class="pt-2">
        <%= f.submit "Ekstreyi İçe Aktar ve Analiz Et", class: "w-full py-3 px-6 rounded-lg bg-[#B91C1C] hover:bg-[#991B1B] text-zinc-100 font-medium text-sm tracking-normal transition-colors border border-red-700/60 active:scale-[0.99] cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>

