<div class="space-y-6">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">Ekstre Geçmişi</h1>
      <p class="text-sm text-slate-400 mt-1">Yüklediğiniz tüm banka ekstreleri ve kategorizasyon durumları.</p>
    </div>
    <%= link_to new_statement_path, class: "inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-sm shadow-lg shadow-emerald-500/20 transition-all hover:scale-[1.02] active:scale-[0.98]" do %>
      <span>+</span> Yeni Ekstre Yükle
    <% end %>
  </div>

  <% if @statements.empty? %>
    <div class="bg-slate-900/40 border border-slate-800/80 rounded-2xl p-12 text-center">
      <div class="w-16 h-16 rounded-2xl bg-slate-800 text-slate-400 flex items-center justify-center mx-auto mb-4 text-2xl">
        📄
      </div>
      <h3 class="text-lg font-semibold text-slate-200">Henüz ekstre yüklenmedi</h3>
      <p class="text-sm text-slate-500 mt-1 mb-6">Hemen ilk banka ekstrenizi yükleyerek harcamalarınızı analiz etmeye başlayın.</p>
      <%= link_to "İlk Ekstreni Yükle", new_statement_path, class: "inline-flex items-center px-5 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold text-sm transition-all" %>
    </div>
  <% else %>
    <div class="grid grid-cols-1 gap-4">
      <% @statements.each do |statement| %>
        <div class="bg-slate-900/70 border border-slate-800/80 hover:border-slate-700/80 rounded-2xl p-5 sm:p-6 transition-all backdrop-blur-sm">
          <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
            <div class="space-y-1">
              <div class="flex items-center gap-3">
                <span class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                  <%= statement.bank_name.presence || "Banka Belirtilmedi" %>
                </span>
                <span class="text-xs text-slate-500">
                  <%= statement.imported_at.strftime("%d.%m.%Y %H:%M") %>
                </span>
              </div>
              <h3 class="text-lg font-semibold text-white tracking-tight flex items-center gap-2">
                <%= statement.source_filename %>
              </h3>
              <p class="text-xs text-slate-400">
                Toplam <span class="font-semibold text-slate-200"><%= statement.transactions.count %></span> işlem 
                • Toplam Harcama: <span class="font-semibold text-rose-400"><%= sprintf("%.2f TL", statement.total_spent) %></span>
                <% if statement.total_income > 0 %>
                  • Gelir: <span class="font-semibold text-emerald-400"><%= sprintf("%.2f TL", statement.total_income) %></span>
                <% end %>
              </p>
            </div>

            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 w-full md:w-auto justify-end">
              <!-- Progress -->
              <div class="w-full sm:w-44 space-y-1">
                <div class="flex justify-between text-xs">
                  <span class="text-slate-400">Kategorilendi</span>
                  <span class="font-semibold text-emerald-400">%<%= statement.categorization_percentage %></span>
                </div>
                <div class="w-full h-2 bg-slate-800 rounded-full overflow-hidden">
                  <div class="h-full bg-gradient-to-r from-emerald-500 to-teal-400 rounded-full" style="width: <%= statement.categorization_percentage %>%"></div>
                </div>
              </div>

              <!-- Action buttons -->
              <div class="flex items-center gap-2">
                <%= link_to "İncele", statement_path(statement), class: "px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-sm font-semibold text-slate-200 transition-colors" %>
                <%= button_to "Sil", statement_path(statement), method: :delete, data: { turbo_confirm: "Bu ekstreyi ve tüm işlemlerini silmek istediğinize emin misiniz?" }, class: "px-3 py-2 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 text-sm font-medium transition-colors cursor-pointer" %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
