<!DOCTYPE html>
<html lang="tr" class="h-full bg-[#121316] text-[#ECEEF2] antialiased">
  <head>
    <title><%= content_for(:title) || "Ekstre Banking — Bütçe & Harcama Takibi" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Ekstre Banking">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        letter-spacing: -0.011em;
      }
      .font-tabular {
        font-variant-numeric: tabular-nums;
        letter-spacing: -0.02em;
      }
    </style>
  </head>

  <body class="min-h-full flex flex-col bg-[#121316] text-[#ECEEF2] selection:bg-[#B91C1C] selection:text-white">
    <%= render "shared/navigation" %>

    <!-- Flash Notifications -->
    <div id="flash-messages" class="fixed top-20 right-4 z-50 flex flex-col gap-2 max-w-md w-full pointer-events-none px-4">
      <% if notice.present? %>
        <div class="pointer-events-auto flex items-center justify-between p-4 rounded-xl bg-[#1C1D22] border border-[#2E303A] text-white shadow-lg">
          <div class="flex items-center gap-3">
            <span class="w-5 h-5 rounded-full bg-emerald-500/15 text-emerald-400 flex items-center justify-center font-bold text-xs">✓</span>
            <p class="text-xs sm:text-sm font-medium text-zinc-300"><%= notice %></p>
          </div>
          <button onclick="this.parentElement.remove()" class="text-zinc-500 hover:text-white text-xs ml-3 p-1">✕</button>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="pointer-events-auto flex items-center justify-between p-4 rounded-xl bg-[#1C1D22] border border-red-900/40 text-white shadow-lg">
          <div class="flex items-center gap-3">
            <span class="w-5 h-5 rounded-full bg-red-500/15 text-red-400 flex items-center justify-center font-bold text-xs">!</span>
            <p class="text-xs sm:text-sm font-medium text-zinc-300"><%= alert %></p>
          </div>
          <button onclick="this.parentElement.remove()" class="text-zinc-500 hover:text-white text-xs ml-3 p-1">✕</button>
        </div>
      <% end %>
    </div>

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>

    <footer class="border-t border-zinc-900 py-6 text-center text-xs text-zinc-500">
      <div class="flex items-center justify-center gap-2 mb-1">
        <span class="w-2 h-2 rounded-full bg-red-600 inline-block"></span>
        <span class="font-semibold text-zinc-400">Ekstre Banking</span>
      </div>
      <p>Bank Statement Budget Tracker &copy; <%= Date.current.year %></p>
    </footer>
  </body>
</html>
