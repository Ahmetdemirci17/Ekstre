<!DOCTYPE html>
<html lang="tr" class="h-full bg-slate-950 text-slate-100">
  <head>
    <title><%= content_for(:title) || "EkstreAI — Bank Statement Budget Tracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="EkstreAI">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
      body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
    </style>
  </head>

  <body class="min-h-full flex flex-col bg-slate-950 text-slate-100 selection:bg-emerald-500 selection:text-slate-950">
    <%= render "shared/navigation" %>

    <!-- Flash Notifications -->
    <div id="flash-messages" class="fixed top-20 right-4 z-50 flex flex-col gap-2 max-w-md w-full pointer-events-none px-4">
      <% if notice.present? %>
        <div class="pointer-events-auto flex items-center justify-between p-4 rounded-xl bg-slate-900/90 border border-emerald-500/40 text-emerald-400 shadow-xl backdrop-blur-md animate-fade-in">
          <div class="flex items-center gap-3">
            <span class="text-xl">✅</span>
            <p class="text-sm font-medium text-slate-200"><%= notice %></p>
          </div>
          <button onclick="this.parentElement.remove()" class="text-slate-400 hover:text-white text-sm ml-3">✕</button>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="pointer-events-auto flex items-center justify-between p-4 rounded-xl bg-slate-900/90 border border-rose-500/40 text-rose-400 shadow-xl backdrop-blur-md animate-fade-in">
          <div class="flex items-center gap-3">
            <span class="text-xl">⚠️</span>
            <p class="text-sm font-medium text-slate-200"><%= alert %></p>
          </div>
          <button onclick="this.parentElement.remove()" class="text-slate-400 hover:text-white text-sm ml-3">✕</button>
        </div>
      <% end %>
    </div>

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>

    <footer class="border-t border-slate-900 py-6 text-center text-xs text-slate-500">
      <p>EkstreAI &copy; <%= Date.current.year %> — Yapay Zeka Destekli Bütçe ve Ekstre Takip Sistemi</p>
    </footer>
  </body>
</html>
