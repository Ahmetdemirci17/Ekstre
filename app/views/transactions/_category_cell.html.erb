<%= turbo_frame_tag dom_id(transaction, :category) do %>
  <%= form_with(model: transaction, url: transaction_path(transaction), method: :patch, class: "flex items-center gap-2") do |f| %>
    <div class="relative inline-flex items-center">
      <% if transaction.category %>
        <span class="w-2.5 h-2.5 rounded-full mr-2 shrink-0" style="background-color: <%= transaction.category.color %>"></span>
      <% else %>
        <span class="w-2.5 h-2.5 rounded-full mr-2 shrink-0 bg-zinc-600"></span>
      <% end %>

      <%= f.collection_select :category_id, 
            Category.order(:name), 
            :id, 
            :name, 
            { include_blank: "Kategori Ata..." }, 
            { 
              class: "text-xs font-medium rounded-md bg-[#141519] border border-[#2E303A] text-zinc-300 py-1 px-2.5 pr-7 focus:outline-none focus:border-[#B91C1C] transition-colors cursor-pointer",
              onchange: "this.form.requestSubmit()"
            } %>
    </div>

    <% if transaction.ai? %>
      <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-[#241416] text-[#E05252] border border-[#3E1D22]" title="Yapay zeka (Gemini) tarafından atandı">
        AI
      </span>
    <% elsif transaction.manual? %>
      <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-[#1C1D24] text-zinc-400 border border-[#2E303A]" title="Kullanıcı tarafından manuel seçildi">
        Manuel
      </span>
    <% end %>
  <% end %>
<% end %>

