<div class="space-y-8">
  <!-- Header with Month Switcher -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">Bütçe & Harcama Özeti</h1>
      <p class="text-sm text-slate-400 mt-1">
        Dönem: <span class="font-semibold text-emerald-400"><%= @target_date.strftime("%B %Y") %></span>
      </p>
    </div>

    <div class="flex items-center gap-2 bg-slate-900/80 border border-slate-800 p-1.5 rounded-xl">
      <%= link_to dashboard_path(date: (@target_date - 1.month).to_s), class: "p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors", title: "Önceki Ay" do %>
        ←
      <% end %>
      <span class="px-3 text-xs font-semibold text-slate-300">
        <%= @target_date.strftime("%m/%Y") %>
      </span>
      <%= link_to dashboard_path(date: (@target_date + 1.month).to_s), class: "p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors", title: "Sonraki Ay" do %>
        →
      <% end %>
    </div>
  </div>

  <% if @recent_transactions.empty? %>
    <!-- Welcome Empty State -->
    <div class="bg-gradient-to-br from-slate-900 to-slate-950 border border-slate-800 rounded-3xl p-8 sm:p-12 text-center shadow-2xl">
      <div class="w-20 h-20 rounded-3xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center justify-center mx-auto mb-6 text-3xl shadow-xl shadow-emerald-500/10">
        💳
      </div>
      <h2 class="text-2xl font-bold text-white mb-2">Hoş Geldiniz! Henüz Bir Ekstre Yüklenmedi</h2>
      <p class="text-slate-400 max-w-lg mx-auto mb-8 text-sm">
        Banka ekstrenizi (CSV) yükleyerek harcamalarınızı saniyeler içinde yapay zeka ile kategorize edin ve grafiklerle bütçenizi yönetmeye başlayın.
      </p>
      <%= link_to new_statement_path, class: "inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-base shadow-xl shadow-emerald-500/20 transition-all hover:scale-105 active:scale-95" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>İlk Ekstrenizi Yükleyin</span>
      <% end %>
    </div>
  <% else %>
    <!-- KPI Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Total Spent -->
      <div class="bg-slate-900/70 border border-slate-800/80 rounded-2xl p-5 backdrop-blur-sm relative overflow-hidden group">
        <div class="flex items-center justify-between text-xs font-semibold text-slate-400">
          <span>Bu Ay Toplam Harcama</span>
          <span class="text-rose-400 text-base">📉</span>
        </div>
        <div class="mt-2 flex items-baseline gap-2">
          <span class="text-2xl sm:text-3xl font-extrabold text-rose-400"><%= sprintf("%.2f TL", @this_month_spent) %></span>
        </div>
        <div class="mt-2 text-xs">
          <% if @mom_change.present? %>
            <% if @mom_change > 0 %>
              <span class="text-rose-400 font-semibold">▲ %<%= @mom_change %></span>
              <span class="text-slate-500 ml-1">geçen aya göre artış</span>
            <% else %>
              <span class="text-emerald-400 font-semibold">▼ %<%= @mom_change.abs %></span>
              <span class="text-slate-500 ml-1">geçen aya göre düşüş</span>
            <% end %>
          <% else %>
            <span class="text-slate-500">Geçen ay verisi yok</span>
          <% end %>
        </div>
      </div>

      <!-- Total Income -->
      <div class="bg-slate-900/70 border border-slate-800/80 rounded-2xl p-5 backdrop-blur-sm">
        <div class="flex items-center justify-between text-xs font-semibold text-slate-400">
          <span>Bu Ay Toplam Gelir</span>
          <span class="text-emerald-400 text-base">📈</span>
        </div>
        <div class="mt-2 flex items-baseline gap-2">
          <span class="text-2xl sm:text-3xl font-extrabold text-emerald-400"><%= sprintf("%.2f TL", @this_month_income) %></span>
        </div>
        <p class="mt-2 text-xs text-slate-500">
          Maaş, prim ve gelen havaleler
        </p>
      </div>

      <!-- Net Balance -->
      <% net_balance = @this_month_income - @this_month_spent %>
      <div class="bg-slate-900/70 border border-slate-800/80 rounded-2xl p-5 backdrop-blur-sm">
        <div class="flex items-center justify-between text-xs font-semibold text-slate-400">
          <span>Net Tasarruf / Bakiye</span>
          <span class="text-sky-400 text-base">⚖️</span>
        </div>
        <div class="mt-2 flex items-baseline gap-2">
          <span class="text-2xl sm:text-3xl font-extrabold <%= net_balance >= 0 ? 'text-emerald-400' : 'text-rose-400' %>">
            <%= net_balance >= 0 ? "+#{sprintf('%.2f TL', net_balance)}" : sprintf("%.2f TL", net_balance) %>
          </span>
        </div>
        <p class="mt-2 text-xs text-slate-500">
          <%= net_balance >= 0 ? "Bütçe pozitif durumda" : "Harcamalar geliri aştı" %>
        </p>
      </div>

      <!-- Top Category -->
      <div class="bg-slate-900/70 border border-slate-800/80 rounded-2xl p-5 backdrop-blur-sm">
        <div class="flex items-center justify-between text-xs font-semibold text-slate-400">
          <span>En Çok Harcanan Kategori</span>
          <span class="text-purple-400 text-base">🏷️</span>
        </div>
        <div class="mt-2 flex items-center gap-2">
          <span class="w-3 h-3 rounded-full shrink-0" style="background-color: <%= @top_category_color %>"></span>
          <span class="text-xl sm:text-2xl font-extrabold text-white truncate"><%= @top_category_name %></span>
        </div>
        <p class="mt-2 text-xs text-slate-400">
          <span class="font-semibold text-rose-300"><%= sprintf("%.2f TL", @top_category_amount) %></span> harcandı
        </p>
      </div>
    </div>

    <!-- Charts Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Monthly Trend Line Chart (2 Cols) -->
      <div class="lg:col-span-2 bg-slate-900/70 border border-slate-800/80 rounded-2xl p-5 sm:p-6 backdrop-blur-sm flex flex-col justify-between">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-base font-bold text-white">Aylık Harcama & Gelir Trendi</h2>
            <p class="text-xs text-slate-400">Son 6 ayın harcama ve gelir akışı</p>
          </div>
          <span class="text-xs font-medium px-2.5 py-1 rounded-lg bg-slate-800 text-slate-300">Son 6 Ay</span>
        </div>
        <div class="w-full h-64 relative">
          <canvas data-controller="chart"
                  data-chart-type-value="line"
                  data-chart-data-value="<%= @trend_chart_data.to_json %>"
                  data-chart-options-value='{
                    "responsive": true,
                    "maintainAspectRatio": false,
                    "plugins": {
                      "legend": { "position": "top", "labels": { "color": "#94A3B8", "font": { "family": "Plus Jakarta Sans", "size": 11 } } }
                    },
                    "scales": {
                      "x": { "grid": { "color": "rgba(51, 65, 85, 0.4)" }, "ticks": { "color": "#94A3B8" } },
                      "y": { "grid": { "color": "rgba(51, 65, 85, 0.4)" }, "ticks": { "color": "#94A3B8" } }
                    }
                  }'>
          </canvas>
        </div>
      </div>

      <!-- Current Month Category Breakdown Doughnut Chart (1 Col) -->
      <div class="bg-slate-900/70 border border-slate-800/80 rounded-2xl p-5 sm:p-6 backdrop-blur-sm flex flex-col justify-between">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-base font-bold text-white">Kategori Dağılımı</h2>
            <p class="text-xs text-slate-400">Bu ayki giderlerin oransal dağılımı</p>
          </div>
        </div>
        <% if @category_chart_data[:labels].empty? %>
          <div class="h-64 flex flex-col items-center justify-center text-slate-500 text-sm">
            <span>📊</span>
            <p class="mt-2">Bu ay için harcama verisi yok</p>
          </div>
        <% else %>
          <div class="w-full h-64 relative">
            <canvas data-controller="chart"
                    data-chart-type-value="doughnut"
                    data-chart-data-value="<%= @category_chart_data.to_json %>"
                    data-chart-options-value='{
                      "responsive": true,
                      "maintainAspectRatio": false,
                      "cutout": "68%",
                      "plugins": {
                        "legend": { "position": "bottom", "labels": { "color": "#94A3B8", "font": { "family": "Plus Jakarta Sans", "size": 11 }, "boxWidth": 12 } }
                      }
                    }'>
            </canvas>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Recent Transactions Table -->
    <div class="bg-slate-900/70 border border-slate-800/80 rounded-2xl overflow-hidden backdrop-blur-sm shadow-xl">
      <div class="p-5 border-b border-slate-800 flex items-center justify-between">
        <div>
          <h2 class="text-base font-bold text-white">Son İşlemler</h2>
          <p class="text-xs text-slate-400">En son içe aktarılan banka hareketleri</p>
        </div>
        <%= link_to "Tüm Ekstreleri Gör →", statements_path, class: "text-xs font-semibold text-emerald-400 hover:text-emerald-300 transition-colors" %>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-300">
          <thead class="bg-slate-950/60 text-xs uppercase tracking-wider text-slate-400 border-b border-slate-800/80">
            <tr>
              <th class="py-3 px-4 font-semibold">Tarih</th>
              <th class="py-3 px-4 font-semibold">Açıklama</th>
              <th class="py-3 px-4 font-semibold text-right">Tutar</th>
              <th class="py-3 px-4 font-semibold">Kategori</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 font-normal">
            <% @recent_transactions.each do |transaction| %>
              <tr class="hover:bg-slate-800/40 transition-colors">
                <td class="py-3 px-4 whitespace-nowrap text-xs font-mono text-slate-400">
                  <%= transaction.date.strftime("%d.%m.%Y") %>
                </td>
                <td class="py-3 px-4 max-w-sm sm:max-w-md">
                  <div class="font-medium text-white text-xs sm:text-sm truncate" title="<%= transaction.description %>">
                    <%= transaction.description %>
                  </div>
                  <div class="text-[11px] text-slate-500">
                    <%= transaction.statement.bank_name.presence || transaction.statement.source_filename %>
                  </div>
                </td>
                <td class="py-3 px-4 whitespace-nowrap text-right font-semibold text-sm">
                  <% if transaction.amount.negative? %>
                    <span class="text-rose-400"><%= sprintf("%.2f TL", transaction.amount) %></span>
                  <% else %>
                    <span class="text-emerald-400">+<%= sprintf("%.2f TL", transaction.amount) %></span>
                  <% end %>
                </td>
                <td class="py-3 px-4 whitespace-nowrap">
                  <%= render "transactions/category_cell", transaction: transaction %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
