<div class="space-y-8">
  <!-- Header with Period Switcher -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-2 border-b border-[#262830]">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="inline-block w-2 h-2 rounded-full bg-[#B91C1C]"></span>
        <span class="text-xs font-semibold uppercase tracking-wider text-red-400">Bütçe Analitiği</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">Finansal Kontrol Paneli</h1>
      <p class="text-xs sm:text-sm text-zinc-400 mt-1">
        Dönem: <span class="font-semibold text-zinc-200"><%= @target_date.strftime("%B %Y") %></span>
      </p>
    </div>

    <div class="flex items-center gap-1.5 bg-[#141519] border border-[#262830] p-1 rounded-xl">
      <%= link_to dashboard_path(date: (@target_date - 1.month).to_s), class: "px-3 py-1.5 rounded-lg text-zinc-400 hover:text-white hover:bg-[#1F2128] text-xs font-medium transition-colors", title: "Önceki Ay" do %>
        ← Önceki
      <% end %>
      <span class="px-3 py-1 text-xs font-mono font-medium text-zinc-300 bg-[#18191E] rounded-md border border-[#262830]">
        <%= @target_date.strftime("%m / %Y") %>
      </span>
      <%= link_to dashboard_path(date: (@target_date + 1.month).to_s), class: "px-3 py-1.5 rounded-lg text-zinc-400 hover:text-white hover:bg-[#1F2128] text-xs font-medium transition-colors", title: "Sonraki Ay" do %>
        Sonraki →
      <% end %>
    </div>
  </div>

  <% if @recent_transactions.empty? %>
    <!-- Welcome Empty State -->
    <div class="bg-[#18191E] border border-[#262830] rounded-2xl p-10 sm:p-14 text-center">
      <div class="w-14 h-14 rounded-2xl bg-[#241416] text-[#E05252] border border-[#3E1D22] flex items-center justify-center mx-auto mb-4 text-2xl">
        💳
      </div>
      <h2 class="text-xl sm:text-2xl font-bold text-white mb-2">Henüz Bir Banka Ekstresi Yüklenmedi</h2>
      <p class="text-zinc-400 max-w-md mx-auto mb-6 text-xs sm:text-sm leading-relaxed">
        Banka hareketlerinizi içeren CSV veya PDF dosyanızı yükleyerek harcamalarınızı yapay zeka ile otomatik kategorilere ayırın ve anında finansal analizinizi görün.
      </p>
      <%= link_to new_statement_path, class: "inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[#B91C1C] hover:bg-[#991B1B] text-zinc-100 font-medium text-sm transition-colors border border-red-700/60 active:scale-[0.99]" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>Ekstre Yükle</span>
      <% end %>
    </div>
  <% else %>
    <!-- KPI Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Total Spent (Muted Crimson Accent Card) -->
      <div class="bg-[#18191E] border-t-2 border-t-[#B91C1C] border border-[#262830] rounded-xl p-5 relative">
        <div class="flex items-center justify-between text-xs font-medium text-zinc-400">
          <span>Bu Ay Toplam Gider</span>
          <span class="w-2 h-2 rounded-full bg-[#B91C1C]"></span>
        </div>
        <div class="mt-3">
          <span class="text-2xl sm:text-3xl font-bold tracking-tight text-white font-tabular">
            <%= sprintf("%.2f ₺", @this_month_spent) %>
          </span>
        </div>
        <div class="mt-2 text-xs font-tabular">
          <% if @mom_change.present? %>
            <% if @mom_change > 0 %>
              <span class="text-[#E05252] font-semibold">▲ %<%= @mom_change %></span>
              <span class="text-zinc-500 ml-1">önceki aya göre artış</span>
            <% else %>
              <span class="text-[#34D399] font-semibold">▼ %<%= @mom_change.abs %></span>
              <span class="text-zinc-500 ml-1">önceki aya göre tasarruf</span>
            <% end %>
          <% else %>
            <span class="text-zinc-500">İlk ekstre dönemi</span>
          <% end %>
        </div>
      </div>

      <!-- Total Income -->
      <div class="bg-[#18191E] border-t-2 border-t-[#059669] border border-[#262830] rounded-xl p-5">
        <div class="flex items-center justify-between text-xs font-medium text-zinc-400">
          <span>Bu Ay Toplam Gelir</span>
          <span class="w-2 h-2 rounded-full bg-[#059669]"></span>
        </div>
        <div class="mt-3">
          <span class="text-2xl sm:text-3xl font-bold tracking-tight text-[#34D399] font-tabular">
            <%= sprintf("+%.2f ₺", @this_month_income) %>
          </span>
        </div>
        <p class="mt-2 text-xs text-zinc-500">
          Maaş, prim ve gelen transferler
        </p>
      </div>

      <!-- Net Balance -->
      <% net_balance = @this_month_income - @this_month_spent %>
      <div class="bg-[#18191E] border border-[#262830] rounded-xl p-5">
        <div class="flex items-center justify-between text-xs font-medium text-zinc-400">
          <span>Net Finansal Durum</span>
          <span class="w-2 h-2 rounded-full <%= net_balance >= 0 ? 'bg-[#059669]' : 'bg-[#B91C1C]' %>"></span>
        </div>
        <div class="mt-3">
          <span class="text-2xl sm:text-3xl font-bold tracking-tight <%= net_balance >= 0 ? 'text-white' : 'text-[#E05252]' %> font-tabular">
            <%= net_balance >= 0 ? "+#{sprintf('%.2f ₺', net_balance)}" : sprintf("%.2f ₺", net_balance) %>
          </span>
        </div>
        <p class="mt-2 text-xs text-zinc-500">
          <%= net_balance >= 0 ? "Bütçe fazlası / Tasarruf" : "Gelir açığı mevcut" %>
        </p>
      </div>

      <!-- Top Category -->
      <div class="bg-[#18191E] border border-[#262830] rounded-xl p-5">
        <div class="flex items-center justify-between text-xs font-medium text-zinc-400">
          <span>Ağırlıklı Harcama</span>
          <span class="text-xs text-zinc-400">🏷️</span>
        </div>
        <div class="mt-3 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background-color: <%= @top_category_color %>"></span>
          <span class="text-xl sm:text-2xl font-bold text-white truncate"><%= @top_category_name %></span>
        </div>
        <p class="mt-2 text-xs text-zinc-400 font-tabular">
          <span class="font-semibold text-[#E05252]"><%= sprintf("%.2f ₺", @top_category_amount) %></span> harcandı
        </p>
      </div>
    </div>

    <!-- Charts Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Monthly Trend Line Chart (2 Cols) -->
      <div class="lg:col-span-2 bg-[#18191E] border border-[#262830] rounded-xl p-5 sm:p-6 flex flex-col justify-between"
           data-controller="chart"
           data-chart-type-value="line"
           data-chart-data-value="<%= @trend_chart_data.to_json %>"
           data-chart-options-value='{
             "responsive": true,
             "maintainAspectRatio": false,
             "interaction": { "mode": "index", "intersect": false },
             "plugins": {
               "legend": { "display": false }
             },
             "scales": {
               "x": { "grid": { "color": "rgba(255, 255, 255, 0.04)" }, "ticks": { "color": "#6B707E", "font": { "family": "Inter", "size": 11 } } },
               "y": { "grid": { "color": "rgba(255, 255, 255, 0.04)" }, "ticks": { "color": "#6B707E", "font": { "family": "Inter", "size": 11 } } }
             }
           }'>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4 pb-3 border-b border-[#262830]">
          <div>
            <h2 class="text-sm sm:text-base font-semibold text-white tracking-tight">Harcama & Gelir Trendi</h2>
            <p class="text-xs text-zinc-400">Son 6 aylık nakit akışı değişimi</p>
          </div>

          <!-- Interactive Legend Buttons with Checkboxes -->
          <div class="flex items-center gap-2">
            <!-- Harcamalar (Gider) -->
            <button type="button"
                    data-action="click->chart#toggleDataset"
                    data-chart-dataset-index-param="0"
                    data-chart-color="#B91C1C"
                    aria-pressed="true"
                    title="Grafikte gösteriliyor (Gizlemek için tıklayın)"
                    class="group flex items-center gap-2 px-2.5 py-1.5 rounded-lg border border-[#262830] bg-[#141519] hover:bg-[#1E2026] text-xs font-medium transition-all cursor-pointer select-none">
              <span class="legend-box w-3.5 h-3.5 rounded flex items-center justify-center border transition-all"
                    style="background-color: #B91C1C; border-color: #B91C1C;">
                <svg class="legend-check w-2.5 h-2.5 text-white transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                </svg>
              </span>
              <span class="legend-label text-zinc-200">Harcamalar (Gider)</span>
            </button>

            <!-- Gelirler -->
            <button type="button"
                    data-action="click->chart#toggleDataset"
                    data-chart-dataset-index-param="1"
                    data-chart-color="#059669"
                    aria-pressed="true"
                    title="Grafikte gösteriliyor (Gizlemek için tıklayın)"
                    class="group flex items-center gap-2 px-2.5 py-1.5 rounded-lg border border-[#262830] bg-[#141519] hover:bg-[#1E2026] text-xs font-medium transition-all cursor-pointer select-none">
              <span class="legend-box w-3.5 h-3.5 rounded flex items-center justify-center border transition-all"
                    style="background-color: #059669; border-color: #059669;">
                <svg class="legend-check w-2.5 h-2.5 text-white transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                </svg>
              </span>
              <span class="legend-label text-zinc-200">Gelirler</span>
            </button>
          </div>
        </div>
        <div class="w-full h-64 relative">
          <canvas data-chart-target="canvas"></canvas>
        </div>
      </div>

      <!-- Current Month Category Breakdown Doughnut Chart (1 Col) -->
      <div class="bg-[#18191E] border border-[#262830] rounded-xl p-5 sm:p-6 flex flex-col justify-between"
           data-controller="chart"
           data-chart-type-value="doughnut"
           data-chart-data-value="<%= @category_chart_data.to_json %>"
           data-chart-options-value='{
             "responsive": true,
             "maintainAspectRatio": false,
             "cutout": "72%",
             "layout": { "padding": 12 },
             "plugins": {
               "legend": { "position": "bottom", "labels": { "color": "#9CA3AF", "font": { "family": "Inter", "size": 11 }, "boxWidth": 10 } },
               "tooltip": {
                 "backgroundColor": "#141519",
                 "titleColor": "#FFFFFF",
                 "bodyColor": "#ECEEF2",
                 "borderColor": "#2E303A",
                 "borderWidth": 1,
                 "padding": 10,
                 "boxPadding": 4
               }
             }
           }'>
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-[#262830]">
          <div>
            <h2 class="text-sm sm:text-base font-semibold text-white tracking-tight">Kategori Dağılımı</h2>
            <p class="text-xs text-zinc-400">Bu ayki harcamaların dökümü</p>
          </div>
          <span class="text-[10px] font-medium px-2 py-0.5 rounded bg-[#141519] border border-[#262830] text-zinc-400 hidden sm:inline-block">
            Detay için üzerine gelin
          </span>
        </div>
        <% if @category_chart_data[:labels].empty? %>
          <div class="h-64 flex flex-col items-center justify-center text-zinc-500 text-xs">
            <span class="text-2xl mb-2 opacity-60">📊</span>
            <p>Bu ay için harcama kaydı bulunmuyor</p>
          </div>
        <% else %>
          <div class="w-full h-64 relative flex items-center justify-center">
            <canvas data-chart-target="canvas"></canvas>

            <!-- Center Dynamic Readout with Expanding Pop Animation -->
            <div data-chart-target="centerDisplay"
                 class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none text-center transition-all duration-300 ease-out transform scale-100 p-2">
              <span data-chart-target="centerLabel" class="text-[11px] font-medium text-zinc-400 uppercase tracking-wider transition-colors duration-200 truncate max-w-[140px]">
                Toplam Harcama
              </span>
              <span data-chart-target="centerValue" class="text-base sm:text-lg font-bold font-tabular text-white tracking-tight mt-0.5 transition-all duration-200">
                <%= sprintf("%.2f ₺", @this_month_spent) %>
              </span>
              <span data-chart-target="centerBadge" class="hidden text-[10px] font-semibold px-2 py-0.5 rounded-full mt-1 border transition-all duration-200 font-tabular">
              </span>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Recent Transactions Table -->
    <div class="bg-[#18191E] border border-[#262830] rounded-xl overflow-hidden">
      <div class="p-5 border-b border-[#262830] flex items-center justify-between">
        <div>
          <h2 class="text-sm sm:text-base font-semibold text-white tracking-tight">Son Banka Hareketleri</h2>
          <p class="text-xs text-zinc-400">Sistemde kayıtlı en son işlemler</p>
        </div>
        <%= link_to "Tüm Ekstreler →", statements_path, class: "text-xs font-semibold text-[#E05252] hover:text-[#F87171] transition-colors" %>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-zinc-300">
          <thead class="bg-[#141519] text-[11px] uppercase tracking-wider text-zinc-400 border-b border-[#262830]">
            <tr>
              <th class="py-3 px-4 font-semibold">Tarih</th>
              <th class="py-3 px-4 font-semibold">İşlem Tanımı</th>
              <th class="py-3 px-4 font-semibold text-right">Tutar</th>
              <th class="py-3 px-4 font-semibold">Kategori</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#22242C] font-normal">
            <% @recent_transactions.each do |transaction| %>
              <tr class="hover:bg-[#1F2128]/60 transition-colors">
                <td class="py-3 px-4 whitespace-nowrap text-xs font-tabular text-zinc-400">
                  <%= transaction.date.strftime("%d.%m.%Y") %>
                </td>
                <td class="py-3 px-4 max-w-sm sm:max-w-md">
                  <div class="flex items-center gap-2">
                    <% if transaction.merchant_name.present? %>
                      <span class="font-semibold text-white text-xs sm:text-sm"><%= transaction.merchant_name %></span>
                    <% else %>
                      <span class="font-medium text-white text-xs sm:text-sm truncate" title="<%= transaction.description %>">
                        <%= transaction.description %>
                      </span>
                    <% end %>
                  </div>
                  <% if transaction.ai_analysis.present? %>
                    <div class="text-[11px] text-zinc-300 truncate mt-0.5" title="<%= transaction.ai_analysis %>">
                      <span class="text-[#E05252] text-[10px]">✦</span> <%= transaction.ai_analysis %>
                    </div>
                  <% end %>
                  <div class="text-[10px] text-zinc-500 font-tabular mt-0.5">
                    <%= transaction.statement.bank_name.presence || transaction.statement.source_filename %> • <%= transaction.description.truncate(35) %>
                  </div>
                </td>
                <td class="py-3 px-4 whitespace-nowrap text-right font-semibold text-xs sm:text-sm font-tabular">
                  <% if transaction.amount.negative? %>
                    <span class="text-[#E05252]"><%= sprintf("%.2f ₺", transaction.amount) %></span>
                  <% else %>
                    <span class="text-[#34D399]">+<%= sprintf("%.2f ₺", transaction.amount) %></span>
                  <% end %>
                </td>
                <td class="py-3 px-4 whitespace-nowrap">
                  <%= render "transactions/category_cell", transaction: transaction %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>

